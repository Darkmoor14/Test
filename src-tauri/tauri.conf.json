{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Insta Grup Admin",
  "version": "0.1.0",
  "identifier": "ro.instagrup.admin",
  "build": {
    "frontendDist": "frontend",
    "beforeDevCommand": "bash sync-frontend.sh",
    "beforeBuildCommand": "bash sync-frontend.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Insta Grup Admin",
        "url": "admin-3.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "Insta Grup Admin"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5RTgzQkNEMUE1MTA3RkEKUldUNkIxRWF6VHZvcVNyamtLeVJJck92TDZpeUhLb05wTDVqb1ZGdUJQWXZZTE5LZXdldGluYWgK",
      "endpoints": [
        "https://github.com/Darkmoor14/Test/releases/latest/download/latest.json"
      ]
    }
  }
}
